<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth max-w-full overflow-x-hidden">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>DEMO | Cardápio Digital Interativo</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
          colors: {
            brand: {
              black: '#171717', dark: '#212121', yellow: '#FFB800',
              yellowHover: '#E0A200', red: '#E53935', grayLight: '#F8F9FA', grayBorder: '#E5E7EB'
            }
          },
          boxShadow: { soft: '0 8px 30px rgba(0,0,0,0.06)', floating: '0 12px 35px -4px rgba(0,0,0,0.15)' }
        }
      }
    }
  </script>

  <style>
    html, body { max-width: 100%; overflow-x: hidden; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .badge-open { background-color: #DEF7EC; color: #03543F; }
  </style>
</head>
<body class="bg-[#F8F9FA] text-brand-black antialiased selection:bg-brand-yellow selection:text-brand-black pb-28 md:pb-12 max-w-full overflow-x-hidden">

  <!-- AVISO DE AMBIENTE DE TESTE (TOPO) -->
  <div class="bg-gradient-to-r from-amber-500 via-brand-yellow to-amber-500 text-brand-black px-4 py-2 text-center text-xs font-black shadow-md flex items-center justify-between gap-2 sticky top-0 z-50">
    <span class="flex items-center gap-1.5 truncate">
      <i class="fa-solid fa-flask text-sm"></i>
      <span class="truncate">AMBIENTE DE TESTE • Faça um pedido para testar o sistema!</span>
    </span>
    <a href="teste-admin.html" target="_blank" class="bg-brand-black hover:bg-neutral-800 text-white px-3 py-1 rounded-xl text-[11px] font-black shrink-0 transition shadow-sm flex items-center gap-1">
      <i class="fa-solid fa-desktop"></i>
      <span>ABRIR PAINEL DE TESTE</span>
    </a>
  </div>

  <!-- BARRA FIXA DE RASTREAMENTO FLUTUANTE -->
  <div id="liveTrackingBar" class="hidden fixed top-12 left-2 right-2 sm:left-1/2 sm:-translate-x-1/2 sm:max-w-2xl z-40 bg-neutral-900/95 border border-brand-yellow/60 text-white rounded-2xl shadow-2xl p-2.5 sm:p-3 backdrop-blur-md transition-all duration-300">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center space-x-2.5 truncate cursor-pointer flex-1" onclick="openTrackingModal()">
        <span id="trackBarStatusDot" class="w-3 h-3 rounded-full bg-brand-yellow animate-pulse shrink-0"></span>
        <div class="truncate">
          <div class="flex items-center gap-1.5">
            <span class="text-[10px] font-black uppercase tracking-wider text-brand-yellow" id="trackBarOrderNumber">Pedido #----</span>
            <span class="text-[9px] text-gray-400 font-bold hidden sm:inline">• Toque para detalhes</span>
          </div>
          <p class="text-xs sm:text-sm font-extrabold text-white truncate" id="trackBarStatusText">Carregando status...</p>
        </div>
      </div>
      <div class="flex items-center space-x-1.5 shrink-0">
        <button type="button" id="btnTrackBarConfirmReceived" onclick="confirmCustomerDelivered()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black text-[11px] px-3 py-2 rounded-xl transition shadow-md flex items-center gap-1 cursor-pointer active:scale-95">
          <i class="fa-solid fa-check"></i>
          <span>JÁ RECEBI!</span>
        </button>
        <button type="button" onclick="openTrackingModal()" class="bg-neutral-800 hover:bg-neutral-700 text-brand-yellow font-bold text-xs p-2 rounded-xl border border-neutral-700 transition cursor-pointer" title="Ver Linha do Tempo">
          <i class="fa-solid fa-timeline"></i>
        </button>
      </div>
    </div>
  </div>

  <!-- HEADER -->
  <header class="bg-white shadow-sm border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-3 sm:px-4">
      <div class="h-16 sm:h-20 flex items-center justify-between gap-2">
        <div class="flex items-center space-x-2.5 sm:space-x-3 cursor-pointer shrink-0">
          <div class="w-9 h-9 sm:w-11 sm:h-11 bg-brand-yellow rounded-xl flex items-center justify-center font-black text-brand-black text-lg sm:text-xl shadow-xs">
            <i class="fa-solid fa-burger"></i>
          </div>
          <div>
            <h1 class="text-xs sm:text-lg font-extrabold tracking-tight text-brand-black leading-tight">BURGER HOUSE DEMO</h1>
            <p class="text-[10px] sm:text-[11px] text-gray-500 hidden sm:block">Demonstração ao Vivo</p>
          </div>
        </div>

        <div class="flex items-center space-x-2">
          <button onclick="openCartDrawer()" class="relative bg-brand-black hover:bg-neutral-800 text-white px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl font-bold text-xs sm:text-sm flex items-center space-x-1.5 sm:space-x-2 transition shadow-soft cursor-pointer">
            <i class="fa-solid fa-bag-shopping text-brand-yellow"></i>
            <span class="hidden sm:inline">Meu Pedido</span>
            <span id="cartHeaderCount" class="bg-brand-red text-white text-[10px] sm:text-[11px] font-black w-4 h-4 sm:w-5 sm:h-5 rounded-full inline-flex items-center justify-center">0</span>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- BANNER HERO -->
  <main class="max-w-full overflow-x-hidden">
    <section class="relative bg-brand-black text-white py-8 sm:py-12 overflow-hidden">
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-brand-yellow/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10">
        <h2 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white mb-2">Faça seu Pedido de Teste</h2>
        <p class="text-xs sm:text-sm text-gray-400 max-w-xl">
          Monte seu lanche, finalize o pedido e veja como o sistema transmite tudo em tempo real para a tela da cozinha sem precisar de aplicativo!
        </p>
      </div>
    </section>

    <!-- BARRA DE CATEGORIAS -->
    <section class="bg-white border-b border-gray-200 sticky top-9 z-20 py-2.5 sm:py-3 shadow-xs">
      <div class="max-w-7xl mx-auto px-3 sm:px-4">
        <div id="categoryContainer" class="flex space-x-2 overflow-x-auto no-scrollbar py-0.5"></div>
      </div>
    </section>

    <!-- GRID DE PRODUTOS -->
    <section class="max-w-7xl mx-auto px-3 sm:px-4 py-6 sm:py-8">
      <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5"></div>
    </section>
  </main>

  <!-- MODAL DO PRODUTO COM ADICIONAIS -->
  <div id="productModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl flex flex-col max-h-[90vh]">
      <div class="relative h-56 sm:h-64 bg-neutral-100 overflow-hidden shrink-0">
        <img id="modalProductImg" src="" class="w-full h-full object-cover" />
        <button onclick="closeProductModal()" class="absolute top-4 right-4 w-9 h-9 bg-brand-black/70 hover:bg-brand-black text-white rounded-full flex items-center justify-center transition cursor-pointer">
          <i class="fa-solid fa-xmark text-sm"></i>
        </button>
      </div>

      <div class="p-6 overflow-y-auto">
        <div class="flex justify-between items-start mb-2">
          <h3 id="modalProductName" class="text-xl font-extrabold text-brand-black"></h3>
          <span id="modalProductPrice" class="text-lg font-black text-brand-red"></span>
        </div>
        <p id="modalProductDesc" class="text-sm text-gray-500 mb-5 leading-relaxed"></p>

        <div id="modalAddonsSection" class="hidden mb-6 pt-3 border-t border-gray-100">
          <h4 class="text-xs font-black uppercase text-brand-black tracking-wider mb-2.5">ADICIONAIS ESPECIAIS</h4>
          <div id="modalAddonsList" class="space-y-2 max-h-48 overflow-y-auto pr-1"></div>
        </div>

        <div class="mb-6">
          <label class="block text-xs font-bold uppercase tracking-wider text-gray-700 mb-2">Observação do Item</label>
          <input type="text" id="modalProductNotes" placeholder="Ex: Ponto da carne, sem cebola..." class="w-full text-xs p-3 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-yellow" />
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-gray-100">
          <div class="flex items-center border border-gray-200 rounded-xl overflow-hidden bg-gray-50">
            <button onclick="adjustModalQty(-1)" class="w-10 h-10 flex items-center justify-center text-gray-600 hover:bg-gray-200 font-bold cursor-pointer">-</button>
            <span id="modalQtyDisplay" class="w-10 text-center font-black text-sm text-brand-black">1</span>
            <button onclick="adjustModalQty(1)" class="w-10 h-10 flex items-center justify-center text-gray-600 hover:bg-gray-200 font-bold cursor-pointer">+</button>
          </div>
          <button onclick="confirmAddToCart()" class="flex-1 ml-4 bg-brand-yellow hover:bg-brand-yellowHover text-brand-black font-extrabold py-3 px-4 rounded-xl text-xs sm:text-sm flex items-center justify-center space-x-2 transition cursor-pointer shadow-soft">
            <i class="fa-solid fa-bag-shopping"></i>
            <span id="btnModalAddToCartText">ADICIONAR AO CARRINHO</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL: DECISÃO APÓS ADICIONAR ITEM -->
  <div id="itemAddedModal" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 text-center shadow-2xl animate-in fade-in zoom-in-95 duration-200">
      <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-2xl mx-auto mb-3">
        <i class="fa-solid fa-check"></i>
      </div>
      <h3 class="text-lg font-black text-brand-black mb-1">Item adicionado com sucesso!</h3>
      <p class="text-xs text-gray-500 mb-5">O que você deseja fazer agora?</p>
      <div class="space-y-2.5">
        <button onclick="goToCartFromItemModal()" class="w-full bg-brand-yellow hover:bg-brand-yellowHover text-brand-black font-black py-3 px-4 rounded-xl text-xs sm:text-sm flex items-center justify-center space-x-2 transition shadow-soft cursor-pointer">
          <i class="fa-solid fa-bag-shopping"></i>
          <span>VER CARRINHO / FINALIZAR</span>
        </button>
        <button onclick="continueShopping()" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-3 px-4 rounded-xl text-xs transition cursor-pointer">
          Continuar Comprando
        </button>
      </div>
    </div>
  </div>

  <!-- DRAWER DO CARRINHO -->
  <div id="cartBackdrop" onclick="closeCartDrawer()" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 hidden transition-opacity"></div>
  <aside id="cartDrawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-white z-50 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out">
    <div class="p-5 border-b border-gray-100 flex items-center justify-between bg-brand-black text-white">
      <div class="flex items-center space-x-2">
        <i class="fa-solid fa-bag-shopping text-brand-yellow text-lg"></i>
        <h3 class="font-extrabold text-base">Seu Carrinho de Teste</h3>
      </div>
      <button onclick="closeCartDrawer()" class="text-gray-400 hover:text-white transition w-8 h-8 rounded-full flex items-center justify-center cursor-pointer">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>
    <div id="cartItemsList" class="flex-1 overflow-y-auto p-5 divide-y divide-gray-100"></div>
    <div id="cartFooterArea" class="p-5 bg-gray-50 border-t border-gray-200">
      <div class="space-y-1.5 text-xs mb-4">
        <div class="flex justify-between text-gray-600">
          <span>Subtotal dos Itens</span>
          <span id="cartSubtotalText" class="font-bold text-gray-800">R$ 0,00</span>
        </div>
        <div class="flex justify-between text-gray-500">
          <span>Taxa de Entrega</span>
          <span class="font-semibold text-emerald-700">R$ 5,00 (Fixo Teste)</span>
        </div>
        <div class="flex justify-between text-base font-black text-brand-black pt-2 border-t border-gray-200">
          <span>TOTAL</span>
          <span id="cartGrandTotalText" class="text-brand-black">R$ 0,00</span>
        </div>
      </div>
      <button onclick="startCheckout()" class="w-full bg-brand-yellow hover:bg-brand-yellowHover text-brand-black font-black py-3.5 px-4 rounded-xl text-sm transition shadow-soft flex items-center justify-center space-x-2 cursor-pointer">
        <span>FINALIZAR PEDIDO DE TESTE</span>
        <i class="fa-solid fa-arrow-right"></i>
      </button>
    </div>
  </aside>

  <!-- MODAL DE CHECKOUT -->
  <div id="checkoutModal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl flex flex-col max-h-[92vh]">
      <div class="p-5 bg-brand-black text-white flex items-center justify-between">
        <div>
          <h3 class="font-extrabold text-base">Finalizar Pedido de Demonstração</h3>
          <p class="text-xs text-gray-400">Preencha dados fictícios para testar</p>
        </div>
        <button onclick="closeCheckoutModal()" class="w-8 h-8 rounded-full bg-neutral-800 text-gray-300 cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <form id="checkoutForm" onsubmit="processDemoOrder(event)" class="p-6 overflow-y-auto space-y-4 text-xs">
        <div>
          <label class="block font-bold text-gray-700 mb-1">Seu Nome *</label>
          <input type="text" id="custName" value="Cliente Teste" required class="w-full p-2.5 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-yellow font-bold" />
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">WhatsApp / Telefone</label>
          <input type="tel" id="custPhone" value="(11) 99999-8888" class="w-full p-2.5 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-yellow" />
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">Tipo de Pedido</label>
          <div class="grid grid-cols-3 gap-2">
            <label class="cursor-pointer border rounded-xl p-2 text-center transition border-brand-yellow bg-amber-50">
              <input type="radio" name="orderType" value="delivery" checked class="sr-only" />
              <i class="fa-solid fa-motorcycle text-brand-yellow block mb-0.5"></i>
              <span class="font-black text-[11px]">Delivery</span>
            </label>
            <label class="cursor-pointer border rounded-xl p-2 text-center transition border-gray-200">
              <input type="radio" name="orderType" value="pickup" class="sr-only" />
              <i class="fa-solid fa-store text-blue-500 block mb-0.5"></i>
              <span class="font-black text-[11px]">Retirada</span>
            </label>
            <label class="cursor-pointer border rounded-xl p-2 text-center transition border-gray-200">
              <input type="radio" name="orderType" value="dine_in" class="sr-only" />
              <i class="fa-solid fa-utensils text-emerald-500 block mb-0.5"></i>
              <span class="font-black text-[11px]">Mesa</span>
            </label>
          </div>
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">Endereço de Entrega *</label>
          <input type="text" id="custAddress" value="Av. Paulista, 1000 - Apt 42" required class="w-full p-2.5 rounded-xl border border-gray-200 focus:outline-none focus:border-brand-yellow font-medium" />
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">Forma de Pagamento</label>
          <select id="custPayment" class="w-full p-2.5 rounded-xl border border-gray-200 focus:outline-none font-bold">
            <option value="Pix">Pix</option>
            <option value="Cartão de Crédito">Cartão de Crédito</option>
            <option value="Dinheiro">Dinheiro</option>
          </select>
        </div>
        <div>
          <label class="block font-bold text-gray-700 mb-1">Observações</label>
          <input type="text" id="orderNotes" placeholder="Ex: Caprichar no molho..." class="w-full p-2.5 rounded-xl border border-gray-200" />
        </div>

        <div class="p-3 bg-gray-50 rounded-xl border border-gray-200 flex justify-between font-black text-sm">
          <span>TOTAL DO PEDIDO:</span>
          <span id="chkFinalTotalText" class="text-brand-red">R$ 0,00</span>
        </div>

        <button type="submit" class="w-full bg-brand-yellow hover:bg-brand-yellowHover text-brand-black font-black py-3.5 px-4 rounded-xl text-sm transition shadow-soft flex items-center justify-center space-x-2 cursor-pointer">
          <i class="fa-solid fa-paper-plane"></i>
          <span>ENVIAR PARA O PAINEL DE TESTE</span>
        </button>
      </form>
    </div>
  </div>

  <!-- MODAL: LINHA DO TEMPO DO RASTREAMENTO -->
  <div id="trackingModal" class="fixed inset-0 z-50 bg-black/75 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-md w-full overflow-hidden shadow-2xl flex flex-col max-h-[92vh]">
      <div class="p-5 bg-brand-black text-white flex items-center justify-between">
        <div>
          <span class="text-[10px] font-black uppercase text-brand-yellow tracking-wider" id="trackModalHeaderOrder">PEDIDO #----</span>
          <h3 class="font-black text-base">Acompanhar Pedido ao Vivo</h3>
        </div>
        <button onclick="closeTrackingModal()" class="w-8 h-8 rounded-full bg-neutral-800 text-gray-300 hover:text-white flex items-center justify-center cursor-pointer">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="p-6 overflow-y-auto space-y-6 text-xs">
        <div id="trackModalCurrentBanner" class="p-4 rounded-2xl border text-center transition-all bg-amber-50 border-amber-200">
          <span id="trackModalStatusBadgeText" class="font-black text-sm text-brand-black block uppercase">RECEBIDO PELA LOJA</span>
          <p id="trackModalStatusSubtext" class="text-xs text-gray-600 mt-1">Seu pedido foi registrado e aguarda confirmação da cozinha.</p>
        </div>

        <div class="space-y-4 px-2">
          <div class="flex items-start space-x-3.5" id="stepNode-novo">
            <div class="w-8 h-8 rounded-full bg-brand-yellow text-brand-black flex items-center justify-center font-black shrink-0 shadow-sm animate-pulse" id="stepIcon-novo">
              <i class="fa-solid fa-receipt text-xs"></i>
            </div>
            <div class="flex-1 pt-1">
              <h5 class="font-black text-brand-black text-xs">1. Pedido Recebido</h5>
              <p class="text-[11px] text-gray-500">Seu pedido chegou ao restaurante.</p>
            </div>
          </div>

          <div class="flex items-start space-x-3.5 opacity-40" id="stepNode-preparo">
            <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-black shrink-0 shadow-sm" id="stepIcon-preparo">
              <i class="fa-solid fa-fire text-xs"></i>
            </div>
            <div class="flex-1 pt-1">
              <h5 class="font-black text-brand-black text-xs">2. Na Cozinha (Em Preparo)</h5>
              <p class="text-[11px] text-gray-500">Os ingredientes estão sendo preparados.</p>
            </div>
          </div>

          <div class="flex items-start space-x-3.5 opacity-40" id="stepNode-saiu">
            <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-black shrink-0 shadow-sm" id="stepIcon-saiu">
              <i class="fa-solid fa-motorcycle text-xs"></i>
            </div>
            <div class="flex-1 pt-1">
              <h5 class="font-black text-brand-black text-xs">3. Saiu para Entrega</h5>
              <p class="text-[11px] text-gray-500">O motoboy está a caminho.</p>
            </div>
          </div>

          <div class="flex items-start space-x-3.5 opacity-40" id="stepNode-entregue">
            <div class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center font-black shrink-0 shadow-sm" id="stepIcon-entregue">
              <i class="fa-solid fa-check text-xs"></i>
            </div>
            <div class="flex-1 pt-1">
              <h5 class="font-black text-brand-black text-xs">4. Pedido Entregue</h5>
              <p class="text-[11px] text-gray-500">Bom apetite!</p>
            </div>
          </div>
        </div>

        <div class="space-y-2 pt-2">
          <button type="button" id="btnTrackModalReceived" onclick="confirmCustomerDelivered()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-black py-3.5 px-4 rounded-xl text-xs sm:text-sm flex items-center justify-center space-x-2 transition shadow-soft cursor-pointer">
            <i class="fa-solid fa-check text-base"></i>
            <span>JÁ RECEBI MEU PEDIDO!</span>
          </button>
          <a href="teste-admin.html" target="_blank" class="w-full bg-brand-black hover:bg-neutral-800 text-white font-black py-3 px-4 rounded-xl text-xs flex items-center justify-center gap-1.5 transition">
            <i class="fa-solid fa-desktop text-brand-yellow"></i>
            <span>Ver Este Pedido no Painel da Cozinha</span>
          </a>
          <button type="button" onclick="closeTrackingModal()" class="w-full bg-gray-100 hover:bg-gray-200 text-gray-700 font-bold py-2.5 px-4 rounded-xl text-xs transition cursor-pointer">
            Continuar Olhando o Cardápio
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- MODAL DE AVALIAÇÃO UBER -->
  <div id="submitReviewModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl relative text-center animate-in fade-in zoom-in-95 duration-200">
      <div class="w-14 h-14 rounded-2xl bg-amber-50 text-brand-yellow flex items-center justify-center text-2xl mx-auto mb-2 shadow-inner">
        <i class="fa-solid fa-star"></i>
      </div>
      <h3 class="text-xl font-extrabold text-brand-black">Como foi sua experiência?</h3>
      <p class="text-xs text-gray-500 mb-4">Seu pedido foi entregue! Avalie nosso atendimento.</p>
      
      <div class="flex justify-center items-center space-x-2 text-3xl text-brand-yellow mb-5">
        <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
      </div>
      
      <button onclick="closeSubmitReviewModal()" class="w-full bg-brand-yellow hover:bg-brand-yellowHover text-brand-black font-black py-3 px-4 rounded-xl text-xs transition shadow-soft cursor-pointer">
        CONCLUIR AVALIAÇÃO DE TESTE
      </button>
    </div>
  </div>

  <!-- SCRIPT DE TESTE (100% LOCAL / SEM TOCAR NO SUPABASE) -->
  <script>
    // Canal de rádio para comunicação instantânea entre abas
    const demoChannel = new BroadcastChannel('phsublime_demo_channel');

    const MOCK_CATEGORIES = [
      { id: "all", name: "Todos os Itens", icon: "fa-solid fa-list" },
      { id: "burgers", name: "Burgers Artesanais", icon: "fa-solid fa-burger" },
      { id: "porcoes", name: "Porções & Batatas", icon: "fa-solid fa-bowl-food" },
      { id: "bebidas", name: "Bebidas Geladas", icon: "fa-solid fa-glass-water" }
    ];

    const MOCK_PRODUCTS = [
      {
        id: 101, category: "burgers", name: "Smash Bacon Cheddar",
        description: "Pão brioche selado, 2x smash de 90g, muito cheddar cremoso e fatias crocantes de bacon.",
        price: 28.90, image: "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=800&q=80",
        addons: { items: [{ name: "Bacon Extra", price: 5.00 }, { name: "Maionese Verde", price: 3.50 }, { name: "Carne Extra 90g", price: 8.00 }] }
      },
      {
        id: 102, category: "burgers", name: "Classic Salada Especial",
        description: "Blend 160g suculento, queijo prato derretido, alface fresca, tomate italiano e molho da casa.",
        price: 25.50, image: "https://images.unsplash.com/photo-1550547660-d9450f859349?auto=format&fit=crop&w=800&q=80",
        addons: { items: [{ name: "Ovo Frito", price: 3.00 }, { name: "Cebola Caramelizada", price: 4.00 }] }
      },
      {
        id: 103, category: "porcoes", name: "Batata Supreme Cheddar & Bacon",
        description: "400g de batata rústica crocante coberta com cheddar derretido e farofa crocante de bacon.",
        price: 24.00, image: "https://images.unsplash.com/photo-1573080496219-bb080dd4f877?auto=format&fit=crop&w=800&q=80",
        addons: { items: [{ name: "Molho Barbecue", price: 3.00 }] }
      },
      {
        id: 104, category: "bebidas", name: "Coca-Cola Original 350ml",
        description: "Lata trincando de gelada.",
        price: 6.00, image: "https://images.unsplash.com/photo-1622483767028-3f66f32aef97?auto=format&fit=crop&w=800&q=80",
        addons: { items: [] }
      }
    ];

    let appState = {
      cart: [],
      selectedCategory: "all",
      modalItem: null,
      modalQty: 1,
      modalSelectedAddons: {},
      currentOrder: null
    };

    function formatMoney(v) { return Number(v || 0).toFixed(2).replace('.', ','); }

    document.addEventListener("DOMContentLoaded", () => {
      renderCategories();
      renderProducts();
      checkActiveOrder();

      // Escuta mudanças de status que o painel de admin mandar
      demoChannel.onmessage = (event) => {
        if (event.data && event.data.type === 'STATUS_UPDATE') {
          handleAdminStatusBroadcast(event.data.order);
        }
      };
    });

    function renderCategories() {
      const container = document.getElementById("categoryContainer");
      container.innerHTML = MOCK_CATEGORIES.map(cat => `
        <button onclick="selectCategory('${cat.id}')" class="whitespace-nowrap px-4 py-2 rounded-xl text-xs sm:text-sm flex items-center space-x-2 transition cursor-pointer ${appState.selectedCategory === cat.id ? 'bg-brand-black text-brand-yellow font-extrabold shadow-sm' : 'bg-gray-100 text-gray-700 font-semibold'}">
          <i class="${cat.icon}"></i>
          <span>${cat.name}</span>
        </button>
      `).join("");
    }

    function selectCategory(id) {
      appState.selectedCategory = id;
      renderCategories();
      renderProducts();
    }

    function renderProducts() {
      const grid = document.getElementById("productsGrid");
      let list = MOCK_PRODUCTS;
      if (appState.selectedCategory !== 'all') {
        list = list.filter(p => p.category === appState.selectedCategory);
      }
      grid.innerHTML = list.map(p => `
        <div class="bg-white rounded-2xl border border-gray-200/80 overflow-hidden shadow-sm hover:shadow-soft transition flex flex-col justify-between">
          <div>
            <div class="relative h-44 sm:h-48 overflow-hidden bg-gray-100 cursor-pointer" onclick="openProductModal(${p.id})">
              <img src="${p.image}" class="w-full h-full object-cover hover:scale-105 transition duration-500" />
            </div>
            <div class="p-4">
              <h4 class="font-extrabold text-base text-brand-black">${p.name}</h4>
              <p class="text-xs text-gray-500 mt-1 line-clamp-2 leading-relaxed">${p.description}</p>
            </div>
          </div>
          <div class="p-4 pt-0 flex items-center justify-between mt-2">
            <div>
              <span class="text-[10px] text-gray-400 uppercase font-bold block">Preço</span>
              <span class="text-base font-black text-brand-black">R$ ${formatMoney(p.price)}</span>
            </div>
            <button onclick="openProductModal(${p.id})" class="bg-brand-black hover:bg-brand-yellow hover:text-brand-black text-white text-xs font-black px-4 py-2.5 rounded-xl transition flex items-center space-x-1.5 cursor-pointer">
              <i class="fa-solid fa-plus"></i><span>ADICIONAR</span>
            </button>
          </div>
        </div>
      `).join("");
    }

    function openProductModal(id) {
      const prod = MOCK_PRODUCTS.find(p => p.id === id);
      if (!prod) return;
      appState.modalItem = prod;
      appState.modalQty = 1;
      appState.modalSelectedAddons = {};

      document.getElementById("modalProductImg").src = prod.image;
      document.getElementById("modalProductName").innerText = prod.name;
      document.getElementById("modalProductDesc").innerText = prod.description;
      document.getElementById("modalProductPrice").innerText = `R$ ${formatMoney(prod.price)}`;
      document.getElementById("modalQtyDisplay").innerText = "1";
      document.getElementById("modalProductNotes").value = "";

      const sec = document.getElementById("modalAddonsSection");
      const list = document.getElementById("modalAddonsList");
      if (prod.addons && prod.addons.items && prod.addons.items.length > 0) {
        sec.classList.remove('hidden');
        list.innerHTML = prod.addons.items.map((item, idx) => `
          <div class="flex items-center justify-between p-2.5 bg-gray-50 rounded-xl border border-gray-200">
            <div>
              <span class="font-extrabold text-xs text-brand-black block uppercase">${item.name}</span>
              <span class="text-[11px] font-bold text-gray-500">+ R$ ${formatMoney(item.price)}</span>
            </div>
            <div class="flex items-center space-x-2 bg-white rounded-lg p-1 border border-gray-200">
              <button type="button" onclick="changeAddonQty(${idx}, -1)" class="w-7 h-7 bg-gray-100 rounded font-black text-xs cursor-pointer">-</button>
              <span id="addonQty-${idx}" class="w-5 text-center font-black text-xs text-brand-black">0</span>
              <button type="button" onclick="changeAddonQty(${idx}, 1)" class="w-7 h-7 bg-gray-100 rounded font-black text-xs cursor-pointer">+</button>
            </div>
          </div>
        `).join("");
      } else {
        sec.classList.add('hidden');
      }

      updateModalPrice();
      document.getElementById("productModal").classList.remove("hidden");
    }

    function changeAddonQty(idx, delta) {
      const item = appState.modalItem.addons.items[idx];
      const cur = appState.modalSelectedAddons[item.name] || 0;
      const n = Math.max(0, cur + delta);
      if (n === 0) delete appState.modalSelectedAddons[item.name];
      else appState.modalSelectedAddons[item.name] = n;
      document.getElementById(`addonQty-${idx}`).innerText = n;
      updateModalPrice();
    }

    function updateModalPrice() {
      let unit = Number(appState.modalItem.price);
      if (appState.modalItem.addons && appState.modalItem.addons.items) {
        appState.modalItem.addons.items.forEach(it => {
          unit += (Number(it.price) * (appState.modalSelectedAddons[it.name] || 0));
        });
      }
      document.getElementById("btnModalAddToCartText").innerText = `ADICIONAR • R$ ${formatMoney(unit * appState.modalQty)}`;
    }

    function closeProductModal() { document.getElementById("productModal").classList.add("hidden"); }
    function adjustModalQty(d) {
      if (appState.modalQty + d >= 1) {
        appState.modalQty += d;
        document.getElementById("modalQtyDisplay").innerText = appState.modalQty;
        updateModalPrice();
      }
    }

    function confirmAddToCart() {
      let addons = [];
      let extra = 0;
      if (appState.modalItem.addons && appState.modalItem.addons.items) {
        appState.modalItem.addons.items.forEach(it => {
          const q = appState.modalSelectedAddons[it.name] || 0;
          if (q > 0) { addons.push({ name: it.name, price: it.price, qty: q }); extra += it.price * q; }
        });
      }
      appState.cart.push({
        product: appState.modalItem,
        quantity: appState.modalQty,
        unitPrice: Number(appState.modalItem.price) + extra,
        addons: addons,
        notes: document.getElementById("modalProductNotes").value.trim()
      });
      closeProductModal();
      updateCartBadge();
      document.getElementById("itemAddedModal").classList.remove("hidden");
    }

    function continueShopping() { document.getElementById("itemAddedModal").classList.add("hidden"); }
    function goToCartFromItemModal() {
      document.getElementById("itemAddedModal").classList.add("hidden");
      openCartDrawer();
    }

    function updateCartBadge() {
      const tot = appState.cart.reduce((a, b) => a + b.quantity, 0);
      document.getElementById("cartHeaderCount").innerText = tot;
    }

    function openCartDrawer() {
      const list = document.getElementById("cartItemsList");
      const sub = appState.cart.reduce((a, b) => a + (b.unitPrice * b.quantity), 0);
      document.getElementById("cartSubtotalText").innerText = `R$ ${formatMoney(sub)}`;
      document.getElementById("cartGrandTotalText").innerText = `R$ ${formatMoney(sub + 5.00)}`;

      if (appState.cart.length === 0) {
        list.innerHTML = `<p class="text-center text-gray-400 py-12 font-bold text-xs">Seu carrinho de teste está vazio.</p>`;
      } else {
        list.innerHTML = appState.cart.map((item, idx) => `
          <div class="py-3 flex items-start justify-between">
            <div>
              <h5 class="font-black text-xs text-brand-black">${item.product.name}</h5>
              ${item.addons.map(a => `<p class="text-[10px] text-gray-400">+${a.qty}x ${a.name}</p>`).join('')}
              ${item.notes ? `<p class="text-[10px] text-amber-600 bg-amber-50 rounded px-1 mt-0.5">Obs: ${item.notes}</p>` : ''}
              <p class="text-xs font-black text-brand-red mt-1">R$ ${formatMoney(item.unitPrice * item.quantity)}</p>
            </div>
            <button onclick="appState.cart.splice(${idx},1); updateCartBadge(); openCartDrawer();" class="text-gray-400 hover:text-brand-red text-xs"><i class="fa-solid fa-trash"></i></button>
          </div>
        `).join("");
      }

      document.getElementById("cartBackdrop").classList.remove("hidden");
      document.getElementById("cartDrawer").classList.remove("translate-x-full");
    }

    function closeCartDrawer() {
      document.getElementById("cartDrawer").classList.add("translate-x-full");
      setTimeout(() => document.getElementById("cartBackdrop").classList.add("hidden"), 300);
    }

    function startCheckout() {
      if (appState.cart.length === 0) return alert("Adicione um item para testar!");
      closeCartDrawer();
      const sub = appState.cart.reduce((a, b) => a + (b.unitPrice * b.quantity), 0);
      document.getElementById("chkFinalTotalText").innerText = `R$ ${formatMoney(sub + 5.00)}`;
      document.getElementById("checkoutModal").classList.remove("hidden");
    }

    function closeCheckoutModal() { document.getElementById("checkoutModal").classList.add("hidden"); }

    // GRAVAÇÃO 100% LOCAL DO PEDIDO DE TESTE E DISPARO PARA O ADMIN
    function processDemoOrder(e) {
      e.preventDefault();
      const name = document.getElementById("custName").value.trim();
      const phone = document.getElementById("custPhone").value.trim();
      const addr = document.getElementById("custAddress").value.trim();
      const pay = document.getElementById("custPayment").value;
      const notes = document.getElementById("orderNotes").value.trim();
      const sub = appState.cart.reduce((a, b) => a + (b.unitPrice * b.quantity), 0);
      const total = sub + 5.00;
      const orderId = Math.floor(1000 + Math.random() * 9000);

      const itemsTxt = appState.cart.map(i => {
        let t = `• ${i.quantity}x ${i.product.name} - R$ ${formatMoney(i.unitPrice * i.quantity)}`;
        if (i.addons.length > 0) t += `\n   └ ` + i.addons.map(a => `+${a.qty}x ${a.name}`).join(', ');
        if (i.notes) t += `\n   └ Obs: ${i.notes}`;
        return t;
      }).join("\n");

      const newOrder = {
        id: orderId.toString(),
        client: name, phone: phone,
        address: addr, payment: pay, notes: notes,
        items: itemsTxt, total: total,
        type: "Delivery (Teste)",
        time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        status: "Novo"
      };

      // Salva na memória do navegador daquela pessoa
      let savedOrders = JSON.parse(localStorage.getItem('demo_orders_list') || '[]');
      savedOrders.unshift(newOrder);
      localStorage.setItem('demo_orders_list', JSON.stringify(savedOrders));
      localStorage.setItem('demo_active_order_id', orderId.toString());

      // Avisa a aba do teste-admin.html na mesma hora!
      demoChannel.postMessage({ type: 'NEW_ORDER', order: newOrder });

      appState.cart = [];
      updateCartBadge();
      closeCheckoutModal();

      appState.currentOrder = newOrder;
      renderTrackingBar(newOrder);
      openTrackingModal();
    }

    function checkActiveOrder() {
      const activeId = localStorage.getItem('demo_active_order_id');
      if (activeId) {
        let savedOrders = JSON.parse(localStorage.getItem('demo_orders_list') || '[]');
        const ord = savedOrders.find(o => o.id === activeId);
        if (ord && ord.status !== 'Entregue') {
          appState.currentOrder = ord;
          renderTrackingBar(ord);
        }
      }
    }

    function renderTrackingBar(order) {
      if (!order) return;
      const bar = document.getElementById("liveTrackingBar");
      bar.classList.remove("hidden");
      document.getElementById("trackBarOrderNumber").innerText = `Pedido #${order.id}`;
      document.getElementById("trackModalHeaderOrder").innerText = `PEDIDO #${order.id}`;

      const dot = document.getElementById("trackBarStatusDot");
      const txt = document.getElementById("trackBarStatusText");
      const badge = document.getElementById("trackModalStatusBadgeText");
      const sub = document.getElementById("trackModalStatusSubtext");

      const nodes = {
        novo: document.getElementById('stepNode-novo'),
        preparo: document.getElementById('stepNode-preparo'),
        saiu: document.getElementById('stepNode-saiu'),
        entregue: document.getElementById('stepNode-entregue')
      };
      Object.values(nodes).forEach(n => n.className = "flex items-start space-x-3.5 opacity-40");

      if (order.status === 'Novo') {
        dot.className = "w-3 h-3 rounded-full bg-brand-yellow animate-pulse shrink-0";
        txt.innerText = "Recebido • Aguardando Cozinha";
        badge.innerText = "PEDIDO RECEBIDO PELA LOJA";
        sub.innerText = "Seu pedido de teste foi registrado no painel da cozinha.";
        nodes.novo.className = "flex items-start space-x-3.5 opacity-100";
      } else if (order.status === 'Em preparo') {
        dot.className = "w-3 h-3 rounded-full bg-blue-500 animate-pulse shrink-0";
        txt.innerText = "Na Cozinha • Em Preparo";
        badge.innerText = "EM PREPARO NA COZINHA";
        sub.innerText = "O chapeiro está montando o lanche!";
        nodes.novo.className = "flex items-start space-x-3.5 opacity-100";
        nodes.preparo.className = "flex items-start space-x-3.5 opacity-100";
      } else if (order.status === 'Saiu') {
        dot.className = "w-3 h-3 rounded-full bg-purple-500 animate-pulse shrink-0";
        txt.innerText = "A Caminho • Motoboy na Estrada";
        badge.innerText = "SAIU PARA ENTREGA!";
        sub.innerText = "O motoboy está em trânsito.";
        nodes.novo.className = "flex items-start space-x-3.5 opacity-100";
        nodes.preparo.className = "flex items-start space-x-3.5 opacity-100";
        nodes.saiu.className = "flex items-start space-x-3.5 opacity-100";
      }
    }

    // BAIXA PELO CLIENTE
    function confirmCustomerDelivered() {
      if (!appState.currentOrder) return;
      const ord = appState.currentOrder;
      ord.status = 'Entregue';

      // Atualiza na memória local
      let savedOrders = JSON.parse(localStorage.getItem('demo_orders_list') || '[]');
      const idx = savedOrders.findIndex(o => o.id === ord.id);
      if (idx !== -1) savedOrders[idx] = ord;
      localStorage.setItem('demo_orders_list', JSON.stringify(savedOrders));
      localStorage.removeItem('demo_active_order_id');

      // Avisa o painel admin na mesma hora
      demoChannel.postMessage({ type: 'STATUS_UPDATE', order: ord });

      document.getElementById("liveTrackingBar").classList.add("hidden");
      closeTrackingModal();
      document.getElementById("submitReviewModal").classList.remove("hidden");
    }

    function handleAdminStatusBroadcast(updatedOrder) {
      if (!appState.currentOrder || appState.currentOrder.id !== updatedOrder.id) return;

      if (updatedOrder.status === 'Entregue') {
        document.getElementById("liveTrackingBar").classList.add("hidden");
        closeTrackingModal();
        localStorage.removeItem('demo_active_order_id');
        document.getElementById("submitReviewModal").classList.remove("hidden");
      } else {
        appState.currentOrder = updatedOrder;
        renderTrackingBar(updatedOrder);
      }
    }

    function openTrackingModal() { document.getElementById("trackingModal").classList.remove("hidden"); }
    function closeTrackingModal() { document.getElementById("trackingModal").classList.add("hidden"); }
    function closeSubmitReviewModal() { document.getElementById("submitReviewModal").classList.add("hidden"); }
  </script>
</body>
</html>
