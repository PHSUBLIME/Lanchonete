<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>DEMO | Painel da Cozinha & Gestão</title>

  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com">
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['"Plus Jakarta Sans"', 'sans-serif'] },
          colors: {
            brand: {
              black: '#171717', dark: '#212121', card: '#2A2A2A',
              yellow: '#FFB800', yellowHover: '#E0A200', red: '#E53935'
            }
          }
        }
      }
    }
  </script>

  <style>
    @media print {
      @page { margin: 0 !important; size: auto; }
      html, body {
        margin: 0 !important; padding: 0 !important; height: auto !important;
        min-height: 0 !important; background: #fff !important; color: #000 !important;
        display: block !important; overflow: visible !important;
      }
      body > *:not(#printableReceipt) { display: none !important; }
      #printableReceipt {
        display: block !important; visibility: visible !important; position: relative !important;
        width: 80mm !important; max-width: 100% !important; margin: 0 !important; padding: 8px !important;
        background: #fff !important; color: #000 !important; font-family: monospace !important;
        font-size: 12px !important; page-break-inside: avoid !important; break-inside: avoid !important;
      }
      #printableReceipt * { visibility: visible !important; color: #000 !important; }
    }
  </style>
</head>
<body class="bg-[#0F0F0F] text-gray-100 antialiased min-h-screen font-sans flex flex-col justify-between selection:bg-brand-yellow selection:text-brand-black">

  <!-- NOTIFICAÇÃO FLUTUANTE -->
  <div id="toastNotification" class="fixed top-5 right-5 z-50 transform -translate-y-24 opacity-0 transition-all duration-300 pointer-events-none flex items-center space-x-3 bg-neutral-900 border border-emerald-500/50 text-white px-5 py-3.5 rounded-2xl shadow-2xl">
    <div id="toastIcon" class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-black">
      <i class="fa-solid fa-check"></i>
    </div>
    <div>
      <h5 class="text-xs font-black text-white" id="toastTitle">Sucesso!</h5>
      <p class="text-[11px] text-gray-300" id="toastMessage">Mensagem de aviso.</p>
    </div>
  </div>

  <!-- AVISO DE AMBIENTE DE TESTE (TOPO) -->
  <div class="bg-gradient-to-r from-neutral-900 via-neutral-800 to-neutral-900 border-b border-amber-500/40 text-white px-4 py-2 text-xs font-bold shadow-md flex items-center justify-between gap-2">
    <span class="flex items-center gap-1.5 truncate">
      <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="truncate">PAINEL DE TESTE • Conectado à Loja de Teste via memória local!</span>
    </span>
    <div class="flex items-center gap-2 shrink-0">
      <button onclick="resetDemoOrders()" class="bg-neutral-800 hover:bg-neutral-700 text-brand-yellow border border-neutral-700 px-3 py-1 rounded-xl text-[11px] font-black transition cursor-pointer">
        <i class="fa-solid fa-rotate-left mr-1"></i> Reiniciar Teste
      </button>
      <a href="teste.html" target="_blank" class="bg-brand-yellow hover:bg-brand-yellowHover text-brand-black px-3 py-1 rounded-xl text-[11px] font-black transition shadow-sm flex items-center gap-1">
        <i class="fa-solid fa-store"></i>
        <span>Abrir Loja de Teste</span>
      </a>
    </div>
  </div>

  <!-- DASHBOARD -->
  <div class="flex-1 flex flex-col lg:flex-row">

    <!-- MENU LATERAL -->
    <aside class="w-full lg:w-64 bg-brand-dark border-b lg:border-b-0 lg:border-r border-neutral-800 flex flex-col justify-between shrink-0">
      <div>
        <div class="p-5 border-b border-neutral-800 flex items-center space-x-3">
          <div class="w-10 h-10 rounded-xl bg-brand-yellow flex items-center justify-center font-black text-brand-black text-lg shrink-0">
            <i class="fa-solid fa-burger"></i>
          </div>
          <div>
            <h1 class="font-extrabold text-sm text-white leading-none">BURGER HOUSE</h1>
            <span class="text-[10px] text-brand-yellow font-bold uppercase tracking-wider">Painel Demonstração</span>
          </div>
        </div>

        <!-- CONTROLES -->
        <div class="p-4 border-b border-neutral-800 space-y-2">
          <!-- IMPRESSÃO AUTOMÁTICA -->
          <div class="bg-neutral-900 p-2.5 rounded-2xl border border-neutral-800 flex items-center justify-between text-xs">
            <span class="text-[11px] text-gray-400 font-bold flex items-center gap-1.5">
              <i class="fa-solid fa-print text-brand-yellow"></i>
              <span>Imprimir Auto:</span>
            </span>
            <button onclick="toggleAutoPrint()" id="btnToggleAutoPrint" class="text-[11px] px-2.5 py-1 bg-neutral-800 text-gray-400 font-bold rounded-lg transition cursor-pointer">
              DESLIGADA
            </button>
          </div>

          <!-- TESTAR ALARME -->
          <button onclick="playOrderChime()" class="w-full py-2 px-3 rounded-xl bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 text-[11px] text-gray-300 font-bold flex items-center justify-center gap-1.5 transition cursor-pointer">
            <i class="fa-solid fa-volume-high text-brand-yellow"></i>
            <span>Testar Alarme Sonoro</span>
          </button>
        </div>

        <nav class="p-3 space-y-1 text-xs font-bold">
          <button onclick="setOrderFilter('todos')" id="filter-todos" class="filter-tab w-full flex items-center justify-between px-4 py-3 rounded-xl bg-brand-yellow text-brand-black transition cursor-pointer">
            <span class="flex items-center gap-2"><i class="fa-solid fa-bell"></i> Fila de Pedidos</span>
            <span id="badgeLiveOrders" class="bg-brand-red text-white text-[10px] font-black px-2 py-0.5 rounded-full">0</span>
          </button>
          <button onclick="setOrderFilter('abertos')" id="filter-abertos" class="filter-tab w-full flex items-center justify-between px-4 py-3 rounded-xl text-gray-400 hover:text-white transition cursor-pointer">
            <span class="flex items-center gap-2"><i class="fa-solid fa-fire"></i> Em Aberto</span>
            <span id="badgeAbertos" class="text-gray-500 text-[10px]">0</span>
          </button>
          <button onclick="setOrderFilter('concluidos')" id="filter-concluidos" class="filter-tab w-full flex items-center justify-between px-4 py-3 rounded-xl text-gray-400 hover:text-white transition cursor-pointer">
            <span class="flex items-center gap-2"><i class="fa-solid fa-check"></i> Concluídos</span>
            <span id="badgeConcluidos" class="text-gray-500 text-[10px]">0</span>
          </button>
        </nav>
      </div>

      <div class="p-4 border-t border-neutral-800 text-center">
        <p class="text-[10px] text-gray-500 font-semibold">Ambiente Sandbox Isolado</p>
        <p class="text-[11px] text-gray-400 mt-0.5 font-bold">Nenhum dado é enviado à internet</p>
      </div>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <main class="flex-1 p-4 sm:p-8 overflow-y-auto">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6">
        <div>
          <h2 class="text-2xl font-black text-white">Pedidos Recebidos</h2>
          <p class="text-xs text-gray-400">Faça um pedido na aba da Loja e veja ele aparecer aqui automaticamente!</p>
        </div>
      </div>

      <div id="ordersContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>
    </main>
  </div>

  <div id="printableReceipt" class="hidden"></div>

  <!-- SCRIPT -->
  <script>
    const demoChannel = new BroadcastChannel('phsublime_demo_channel');
    let audioContextInstance = null;
    let activeFilter = 'todos';
    let isAutoPrintEnabled = localStorage.getItem('demo_autoprint_enabled') === 'true';

    function initUserAudio() {
      try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!audioContextInstance) audioContextInstance = new AudioContext();
        if (audioContextInstance.state === 'suspended') audioContextInstance.resume();
      } catch (e) {}
    }
    window.addEventListener('click', initUserAudio);
    window.addEventListener('keydown', initUserAudio);
    window.addEventListener('touchstart', initUserAudio);

    function playOrderChime() {
      try {
        initUserAudio();
        const ctx = audioContextInstance || new (window.AudioContext || window.webkitAudioContext)();
        const now = ctx.currentTime;
        const alarmPattern = [
          { freq: 1046.50, start: 0.00, dur: 0.10 },
          { freq: 1318.51, start: 0.12, dur: 0.15 },
          { freq: 1046.50, start: 0.35, dur: 0.10 },
          { freq: 1318.51, start: 0.47, dur: 0.15 },
          { freq: 1567.98, start: 0.70, dur: 0.12 },
          { freq: 2093.00, start: 0.84, dur: 0.35 }
        ];

        alarmPattern.forEach(t => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'triangle';
          osc.frequency.setValueAtTime(t.freq, now + t.start);
          gain.gain.setValueAtTime(0.001, now + t.start);
          gain.gain.exponentialRampToValueAtTime(0.85, now + t.start + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.001, now + t.start + t.dur);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(now + t.start);
          osc.stop(now + t.start + t.dur + 0.05);
        });
      } catch (e) {}
    }

    function showToast(title, message) {
      const toast = document.getElementById("toastNotification");
      document.getElementById("toastTitle").innerText = title;
      document.getElementById("toastMessage").innerText = message;
      toast.className = "fixed top-5 right-5 z-50 transform translate-y-0 opacity-100 transition-all duration-300 pointer-events-none flex items-center space-x-3 bg-neutral-900 border border-emerald-500/60 text-white px-5 py-3.5 rounded-2xl shadow-2xl";
      setTimeout(() => {
        toast.classList.add("-translate-y-24", "opacity-0");
        toast.classList.remove("translate-y-0", "opacity-100");
      }, 3000);
    }

    document.addEventListener("DOMContentLoaded", () => {
      updateAutoPrintUI();
      loadOrInitDemoOrders();

      // Escuta mensagens disparadas pela aba teste.html
      demoChannel.onmessage = (event) => {
        if (!event.data) return;

        if (event.data.type === 'NEW_ORDER') {
          playOrderChime();
          showToast(`Novo Pedido #${event.data.order.id}!`, `${event.data.order.client} enviou um pedido de teste.`);
          renderOrders();

          if (isAutoPrintEnabled) {
            setTimeout(() => printReceipt(event.data.order), 500);
          }
        } else if (event.data.type === 'STATUS_UPDATE') {
          showToast(`Pedido #${event.data.order.id}`, "O cliente confirmou a entrega na loja!");
          renderOrders();
        }
      };
    });

    function updateAutoPrintUI() {
      const btn = document.getElementById('btnToggleAutoPrint');
      if (!btn) return;
      if (isAutoPrintEnabled) {
        btn.className = "text-[11px] px-2.5 py-1 bg-emerald-950 text-emerald-400 border border-emerald-800 font-black rounded-lg transition cursor-pointer";
        btn.innerText = "LIGADA";
      } else {
        btn.className = "text-[11px] px-2.5 py-1 bg-neutral-800 text-gray-400 font-bold rounded-lg transition cursor-pointer";
        btn.innerText = "DESLIGADA";
      }
    }

    function toggleAutoPrint() {
      isAutoPrintEnabled = !isAutoPrintEnabled;
      localStorage.setItem('demo_autoprint_enabled', isAutoPrintEnabled ? 'true' : 'false');
      updateAutoPrintUI();
      showToast("Impressão Automática", isAutoPrintEnabled ? "LIGADA! Comandas de teste serão impressas." : "DESLIGADA.");
    }

    function getOrders() {
      return JSON.parse(localStorage.getItem('demo_orders_list') || '[]');
    }

    function saveOrders(list) {
      localStorage.setItem('demo_orders_list', JSON.stringify(list));
    }

    function loadOrInitDemoOrders() {
      let orders = getOrders();
      if (orders.length === 0) {
        // Pedido de exemplo inicial para o painel não abrir vazio
        orders = [{
          id: "3540",
          client: "Ana Paula Mendes",
          phone: "(11) 98765-4321",
          address: "Rua Augusta, 500 - Apt 12 (Delivery)",
          payment: "Pix",
          notes: "Tocar o interfone",
          items: "• 1x Smash Bacon Cheddar - R$ 28,90\n   └ +1x Bacon Extra\n• 1x Coca-Cola Original - R$ 6,00",
          total: 39.90,
          type: "Delivery (Teste)",
          time: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          status: "Novo"
        }];
        saveOrders(orders);
      }
      renderOrders();
    }

    function resetDemoOrders() {
      if (confirm("Deseja reiniciar a demonstração? Os pedidos de teste serão restaurados.")) {
        localStorage.removeItem('demo_orders_list');
        localStorage.removeItem('demo_active_order_id');
        loadOrInitDemoOrders();
        showToast("Demonstração Reiniciada", "Pedidos restaurados para o estado inicial.");
      }
    }

    function setOrderFilter(f) {
      activeFilter = f;
      document.querySelectorAll('.filter-tab').forEach(b => {
        b.className = "filter-tab w-full flex items-center justify-between px-4 py-3 rounded-xl text-gray-400 hover:text-white transition cursor-pointer";
      });
      document.getElementById(`filter-${f}`).className = "filter-tab w-full flex items-center justify-between px-4 py-3 rounded-xl bg-brand-yellow text-brand-black transition cursor-pointer";
      renderOrders();
    }

    function renderOrders() {
      const container = document.getElementById("ordersContainer");
      const orders = getOrders();

      const abertos = orders.filter(o => o.status !== 'Entregue' && o.status !== 'Cancelado');
      const concluidos = orders.filter(o => o.status === 'Entregue');

      document.getElementById("badgeLiveOrders").innerText = orders.length;
      document.getElementById("badgeAbertos").innerText = abertos.length;
      document.getElementById("badgeConcluidos").innerText = concluidos.length;

      let list = orders;
      if (activeFilter === 'abertos') list = abertos;
      else if (activeFilter === 'concluidos') list = concluidos;

      if (list.length === 0) {
        container.innerHTML = `
          <div class="col-span-full py-16 text-center bg-brand-dark rounded-3xl border border-neutral-800">
            <i class="fa-solid fa-inbox text-4xl text-neutral-600 mb-3"></i>
            <h3 class="text-base font-extrabold text-white">Nenhum pedido nesta aba</h3>
          </div>
        `;
        return;
      }

      container.innerHTML = list.map(ord => {
        const isEntregue = ord.status === 'Entregue';
        const isCancelado = ord.status === 'Cancelado';

        return `
          <div class="rounded-2xl border p-5 bg-brand-dark border-neutral-800 flex flex-col justify-between">
            <div>
              <div class="flex justify-between items-center mb-3">
                <span class="text-sm font-black text-brand-yellow">#${ord.id}</span>
                <span class="text-[10px] bg-neutral-900 text-gray-400 px-2 py-0.5 rounded-md">${ord.time}</span>
              </div>
              <h4 class="font-extrabold text-white text-base">${ord.client}</h4>
              <p class="text-xs text-gray-400 mb-2">${ord.phone}</p>
              
              <div class="p-3 bg-neutral-900 rounded-xl text-xs mb-3 space-y-1 border border-neutral-800/80">
                <p class="font-bold text-gray-200 whitespace-pre-line">${ord.items}</p>
                ${ord.notes ? `<p class="text-[10px] text-amber-400 bg-amber-950/40 p-1 rounded">Obs: ${ord.notes}</p>` : ''}
                <p class="text-[11px] text-gray-400 pt-1"><i class="fa-solid fa-location-dot mr-1 text-brand-red"></i>${ord.address}</p>
                <p class="text-[11px] text-gray-300 font-semibold pt-1 border-t border-neutral-800">
                  Pagamento: <strong class="text-emerald-400">${ord.payment}</strong>
                </p>
              </div>
            </div>

            <div>
              <div class="flex justify-between items-center mb-3">
                <span class="text-xs text-gray-400 font-bold">Total:</span>
                <span class="text-lg font-black text-brand-yellow">R$ ${Number(ord.total).toFixed(2).replace('.', ',')}</span>
              </div>

              <!-- MUDANÇA DE STATUS QUE TRANSMITE AO CLIENTE -->
              <select onchange="changeOrderStatus('${ord.id}', this.value)" class="w-full text-xs font-extrabold p-2.5 rounded-xl bg-neutral-900 border border-neutral-700 text-white mb-2 focus:outline-none">
                <option value="Novo" ${ord.status === 'Novo' ? 'selected' : ''}>🟡 Novo Pedido</option>
                <option value="Em preparo" ${ord.status === 'Em preparo' ? 'selected' : ''}>🔵 Na Cozinha (Em Preparo)</option>
                <option value="Saiu" ${ord.status === 'Saiu' ? 'selected' : ''}>🚴 Saiu para Entrega</option>
                <option value="Entregue" ${isEntregue ? 'selected' : ''}>✅ Concluído / Entregue</option>
                <option value="Cancelado" ${isCancelado ? 'selected' : ''}>❌ Cancelado</option>
              </select>

              <div class="grid grid-cols-2 gap-2 pt-1">
                <button onclick="printReceipt('${ord.id}')" class="bg-neutral-800 hover:bg-neutral-700 text-white font-bold py-2.5 rounded-xl text-xs flex items-center justify-center gap-1.5 transition cursor-pointer">
                  <i class="fa-solid fa-print"></i>
                  <span>Comanda</span>
                </button>
                <button onclick="changeOrderStatus('${ord.id}', 'Entregue')" class="bg-emerald-600 hover:bg-emerald-500 text-white font-black py-2.5 rounded-xl text-xs flex items-center justify-center gap-1 transition cursor-pointer">
                  <i class="fa-solid fa-check"></i>
                  <span>Baixar</span>
                </button>
              </div>
            </div>
          </div>
        `;
      }).join("");
    }

    function changeOrderStatus(id, newStatus) {
      let orders = getOrders();
      const idx = orders.findIndex(o => o.id === id);
      if (idx === -1) return;

      orders[idx].status = newStatus;
      saveOrders(orders);

      // Avisa a aba teste.html na mesma hora!
      demoChannel.postMessage({ type: 'STATUS_UPDATE', order: orders[idx] });

      renderOrders();
      showToast("Status Atualizado", `Pedido #${id} marcado como ${newStatus}.`);
    }

    function printReceipt(orderOrId) {
      let ord = null;
      if (typeof orderOrId === 'object' && orderOrId !== null) {
        ord = orderOrId;
      } else {
        ord = getOrders().find(o => String(o.id) === String(orderOrId));
      }
      if (!ord) return;

      const receiptArea = document.getElementById("printableReceipt");
      receiptArea.innerHTML = `
        <div style="text-align:center; border-bottom: 1px dashed #000; padding-bottom: 6px; margin-bottom: 6px;">
          <h2 style="font-size: 15px; margin: 0; font-weight: 900;">BURGER HOUSE DEMO</h2>
          <p style="margin: 2px 0; font-size: 10px;">PEDIDO DE DEMONSTRAÇÃO</p>
          <div style="margin: 6px 0; padding: 4px; background: #000; color: #fff; font-size: 13px; font-weight: 900;">
            🛵 ENTREGA DELIVERY
          </div>
        </div>

        <div style="margin-bottom: 6px; font-size: 11px;">
          <p style="margin: 2px 0;"><strong>PEDIDO:</strong> #${ord.id}</p>
          <p style="margin: 2px 0;"><strong>HORÁRIO:</strong> ${ord.time}</p>
          <p style="margin: 2px 0;"><strong>CLIENTE:</strong> ${ord.client}</p>
          <p style="margin: 2px 0;"><strong>ENDEREÇO:</strong> ${ord.address}</p>
        </div>

        <div style="border-top: 1px dashed #000; border-bottom: 1px dashed #000; padding: 6px 0; margin-bottom: 6px; font-size: 12px; font-weight: bold; white-space: pre-line;">
          ${ord.items}
        </div>

        <div style="font-size: 12px; display:flex; justify-content:space-between; font-weight: 900;">
          <span>TOTAL:</span>
          <span>R$ ${Number(ord.total).toFixed(2).replace('.', ',')}</span>
        </div>
      `;

      receiptArea.classList.remove("hidden");
      window.print();
      receiptArea.classList.add("hidden");
    }
  </script>
</body>
</html>
